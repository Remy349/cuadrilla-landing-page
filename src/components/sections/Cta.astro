---
import QuickInstall from '../ui/QuickInstall.astro';
import { ctaSection } from '../../data/cta';
---

<section aria-labelledby="cta-title" class="blueprint border-t border-border">
  <div class="mx-auto max-w-3xl px-4 py-20 text-center sm:px-6 md:py-28">
    <h2 id="cta-title" class="text-4xl font-bold uppercase sm:text-5xl md:text-6xl">{ctaSection.title}</h2>
    <p class="mt-5 text-lg text-muted">{ctaSection.body}</p>
    <div class="mx-auto mt-9 max-w-2xl text-left">
      <QuickInstall id="cta-install" label={ctaSection.tabsLabel} />
    </div>
  </div>
</section>
