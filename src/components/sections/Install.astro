---
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import CodeBlock from '../ui/CodeBlock.astro';
import Tabs from '../ui/Tabs.astro';
import TabPanel from '../ui/TabPanel.astro';
import { installSection, installTabs, modelsSnippet } from '../../data/install';
import { inline } from '../../lib/inline';
---

<div class="hazard" aria-hidden="true"></div>
<Section id="install" labelledby="install-title" class="bg-bg-alt">
  <SectionHeading id="install-title" eyebrow={installSection.eyebrow} title={installSection.title} intro={installSection.intro} />

  <div class="grid gap-12 lg:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)] lg:gap-14">
    <div class="min-w-0">
      <Tabs id="install-tabs" tabs={installTabs} label={installSection.tabsLabel}>
        {
          installTabs.map((tab, i) => (
            <TabPanel group="install-tabs" id={tab.id} selected={i === 0} class="space-y-5 pt-6">
              <p class="text-base text-muted" set:html={inline(tab.description)} />
              {tab.warning && (
                <p class="flex gap-3 rounded-md border border-accent/50 bg-accent-soft p-3 text-base text-fg" role="note">
                  <svg aria-hidden="true" class="mt-1 shrink-0 text-accent" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 3 2 21h20L12 3Z" />
                    <path d="M12 10v5M12 18h.01" />
                  </svg>
                  <span set:html={inline(tab.warning)} />
                </p>
              )}
              {tab.snippets.map((s) => (
                <CodeBlock code={s.code} language={s.lang} label={s.label} />
              ))}
            </TabPanel>
          ))
        }
      </Tabs>

      <ul class="mt-8 space-y-2 border-t border-border pt-6" role="list">
        {
          installSection.notes.map((note) => (
            <li class="flex gap-3 text-base text-muted">
              <span aria-hidden="true" class="mt-[0.7em] h-1.5 w-1.5 shrink-0 bg-accent" />
              <span set:html={inline(note)} />
            </li>
          ))
        }
      </ul>
    </div>

    <div class="min-w-0">
      <div>
        <h3 class="text-2xl font-semibold uppercase">{installSection.nextTitle}</h3>
        <ol class="mt-4 space-y-3" role="list">
          {
            installSection.next.map((step, i) => (
              <li class="flex items-start gap-4">
                <span aria-hidden="true" class="flex h-8 w-8 shrink-0 items-center justify-center rounded border border-accent font-mono text-sm text-accent">
                  {i + 1}
                </span>
                <span class="pt-0.5 text-lg" set:html={inline(step)} />
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>

  <div class="mt-16 grid gap-8 border-t border-border pt-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)] lg:gap-14">
    <div class="min-w-0">
      <h3 class="text-2xl font-semibold uppercase">{installSection.modelsTitle}</h3>
      {installSection.modelsBody.map((p) => <p class="mt-3 text-base text-muted" set:html={inline(p)} />)}
    </div>
    <CodeBlock code={modelsSnippet} language="json" label={installSection.modelsFile} class="min-w-0" />
  </div>
</Section>
