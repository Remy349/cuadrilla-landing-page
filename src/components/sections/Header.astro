---
import Wordmark from '../ui/Wordmark.astro';
import Button from '../ui/Button.astro';
import { links, nav, ui } from '../../data/site';
---

<header class="sticky top-0 z-50 border-b border-border bg-bg/85 backdrop-blur-md supports-[not(backdrop-filter:blur(1px))]:bg-bg">
  <div class="mx-auto flex h-16 w-full max-w-(--container-page) items-center justify-between gap-6 px-4 sm:px-6 lg:px-8">
    <a href="#top" class="rounded-sm" aria-label={ui.homeAria}>
      <Wordmark />
    </a>

    <nav aria-label={ui.navLabel} class="hidden lg:block">
      <ul class="flex items-center gap-7">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="text-sm font-medium uppercase tracking-wider text-muted transition-colors hover:text-fg">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <Button href={links.repo} variant="secondary" size="sm" external aria-label={ui.githubAria}>
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
        </svg>
        <span>{ui.github}</span>
      </Button>
      <button
        type="button"
        class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-border-strong text-fg lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label={ui.menuOpen}
        data-label-open={ui.menuOpen}
        data-label-close={ui.menuClose}
        data-menu-toggle
      >
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path class="menu-open" d="M4 7h16M4 12h16M4 17h16" />
          <path class="menu-close" d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" aria-label={ui.mobileNavLabel} class="border-t border-border bg-bg lg:hidden" hidden>
    <ul class="mx-auto flex max-w-(--container-page) flex-col px-4 py-3 sm:px-6">
      {
        nav.map((item) => (
          <li>
            <a href={item.href} class="block border-b border-border py-3 text-lg font-medium uppercase tracking-wider last:border-0" data-menu-link>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .menu-close {
    display: none;
  }
  [aria-expanded='true'] .menu-open {
    display: none;
  }
  [aria-expanded='true'] .menu-close {
    display: inline;
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.getElementById('mobile-nav');

  if (toggle && panel) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? '');
      panel.hidden = !open;
    };

    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    panel.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
    window.matchMedia('(min-width: 64rem)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>
