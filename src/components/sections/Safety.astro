---
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { safety, safetySection } from '../../data/safety';
import { inline } from '../../lib/inline';
---

<Section id="safety" labelledby="safety-title">
  <SectionHeading id="safety-title" eyebrow={safetySection.eyebrow} title={safetySection.title} intro={safetySection.intro} />

  <ul class="grid gap-px overflow-hidden rounded-(--radius-card) border border-border bg-border sm:grid-cols-2 lg:grid-cols-4" role="list">
    {
      safety.map((item, i) => (
        <li class="group relative bg-surface p-6 transition-colors hover:bg-surface-2" data-reveal style={`--reveal-delay: ${(i % 4) * 70}ms`}>
          <span aria-hidden="true" class="absolute inset-x-0 top-0 h-px bg-accent opacity-0 transition-opacity group-hover:opacity-100" />
          <p aria-hidden="true" class="font-mono text-sm text-accent">S-{String(i + 1).padStart(2, '0')}</p>
          <h3 class="mt-3 text-xl font-semibold uppercase">{item.title}</h3>
          <p class="mt-2 text-base text-muted" set:html={inline(item.body)} />
        </li>
      ))
    }
  </ul>
</Section>
