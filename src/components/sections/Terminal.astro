---
import { terminal } from '../../data/hero';

const START_MS = 1400;
const STEP_MS = 320;
---

<figure class="terminal card overflow-hidden shadow-[0_0_0_1px_#00000080]" style={`--chars: ${terminal.request.length}`}>
  <div class="flex items-center gap-3 border-b border-border bg-surface-2 px-4 py-2.5">
    <span aria-hidden="true" class="flex gap-1.5">
      <span class="h-2.5 w-2.5 rounded-full bg-border-strong"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-border-strong"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-accent"></span>
    </span>
    <span class="truncate font-mono text-xs text-muted">{terminal.title}</span>
  </div>

  <div class="term-body px-4 py-4 font-mono text-[0.75rem] leading-relaxed sm:px-5 sm:text-[0.8125rem]">
    <p class="flex gap-2 text-fg">
      <span aria-hidden="true" class="text-accent">&gt;</span>
      <span class="typed">{terminal.request}</span>
    </p>
    <ol class="mt-3 space-y-0.5" role="list">
      {
        terminal.lines.map((line, i) => (
          <li class:list={['term-line', `tone-${line.tone}`]} style={`--delay: ${START_MS + i * STEP_MS}ms`}>
            <span class="term-text">{line.text}</span>
            {line.aside && <span class="term-aside">{line.aside}</span>}
          </li>
        ))
      }
    </ol>
    <p class="term-line mt-3 text-muted" style={`--delay: ${START_MS + terminal.lines.length * STEP_MS}ms`} aria-hidden="true">
      <span class="text-accent">&gt;</span> <span class="cursor"></span>
    </p>
  </div>
  <figcaption class="border-t border-border px-4 py-2 font-mono text-xs text-muted">{terminal.caption}</figcaption>
</figure>

<style>
  .terminal {
    letter-spacing: 0;
  }

  .term-line {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 1rem;
    white-space: pre-wrap;
  }

  .term-aside {
    color: var(--color-muted);
    text-align: right;
  }

  .tone-agent .term-text {
    color: var(--color-fg);
  }
  .tone-agent .term-aside {
    color: var(--color-bg);
    background: var(--color-accent);
    padding: 0 0.4rem;
    border-radius: 3px;
    font-weight: 600;
  }
  .tone-muted {
    color: var(--color-muted);
  }
  .tone-plan .term-text {
    color: var(--color-fg);
  }
  .tone-plan .term-aside,
  .tone-delegate .term-aside,
  .tone-ok .term-aside {
    color: var(--color-accent);
  }
  .tone-delegate .term-text {
    color: var(--color-muted);
  }
  .tone-ok .term-text {
    color: var(--color-ok);
  }
  .tone-report {
    margin-top: 0.5rem;
    padding-top: 0.5rem;
    border-top: 1px dashed var(--color-border-strong);
    color: var(--color-fg);
  }

  .typed {
    display: inline-block;
    max-width: calc(var(--chars) * 1ch);
    overflow: hidden;
    white-space: nowrap;
    vertical-align: bottom;
  }

  .cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    vertical-align: text-bottom;
    background: var(--color-fg);
  }

  @media (max-width: 30rem) {
    .typed {
      white-space: normal;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .typed {
      width: 0;
      animation: type 1s steps(var(--chars), end) 0.2s forwards;
    }
    @media (max-width: 30rem) {
      .typed {
        width: auto;
        white-space: normal;
        animation: fade 0.3s ease 0.2s backwards;
      }
    }
    .term-line {
      animation: fade 0.25s ease var(--delay) backwards;
    }
    .cursor {
      animation: blink 1s steps(1) infinite;
    }
  }

  @keyframes type {
    to {
      width: calc(var(--chars) * 1ch);
    }
  }
  @keyframes fade {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
</style>
