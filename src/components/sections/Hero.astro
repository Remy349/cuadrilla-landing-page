---
import Button from '../ui/Button.astro';
import QuickInstall from '../ui/QuickInstall.astro';
import { hero } from '../../data/hero';
import { links } from '../../data/site';
---

<section aria-labelledby="hero-title" class="blueprint relative border-b border-border">
  <div class="mx-auto max-w-3xl px-4 pt-14 pb-20 text-center sm:px-6 md:pt-20 lg:px-8 lg:pt-24 lg:pb-28">
    <h1 id="hero-title" class="text-[2.75rem] leading-[0.98] font-bold uppercase tracking-[-0.01em] sm:text-6xl lg:text-7xl">
      {hero.headline}
    </h1>
    <p class="mx-auto mt-6 max-w-xl text-lg text-muted sm:text-xl">{hero.subhead}</p>

    <div class="mx-auto mt-9 max-w-xl text-left">
      <p class="mb-1 text-sm font-medium uppercase tracking-wider text-fg">{hero.installLabel}</p>
      <QuickInstall id="hero-install" label={hero.installLabel} />
    </div>

    <div class="mt-7 flex flex-wrap justify-center gap-3">
      <Button href={links.repo} external>{hero.ctaPrimary.label}</Button>
      <Button href={hero.ctaSecondary.href} variant="secondary">{hero.ctaSecondary.label}</Button>
    </div>
    <p class="mt-5 text-sm text-muted">{hero.requirementsNote}</p>
  </div>
</section>
