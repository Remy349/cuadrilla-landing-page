---
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Card from '../ui/Card.astro';
import CodeBlock from '../ui/CodeBlock.astro';
import Badge from '../ui/Badge.astro';
import { commandSection, commands } from '../../data/commands';
---

<Section id="commands" labelledby="commands-title" class="border-t border-border">
  <SectionHeading id="commands-title" eyebrow={commandSection.eyebrow} title={commandSection.title} intro={commandSection.intro} />

  <ul class="grid gap-4 lg:grid-cols-3" role="list">
    {
      commands.map((cmd, i) => (
        <Card as="li" class="flex min-w-0 flex-col p-5 sm:p-6" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
          <h3 class="font-mono text-lg font-semibold tracking-normal break-words">
            <span class="text-accent">{cmd.name}</span> <span class="font-normal text-muted">{cmd.args}</span>
          </h3>
          <p class="mt-3 text-base text-muted">{cmd.description}</p>
          {cmd.outcomes && (
            <div class="mt-4">
              <p class="mb-2 text-sm uppercase tracking-wider text-muted">{commandSection.outcomesLabel}</p>
              <ul class="flex flex-wrap gap-2" role="list">
                {cmd.outcomes.map((o, j) => (
                  <li>
                    <Badge tone={j === 0 ? 'ok' : j === 1 ? 'accent' : 'outline'}>{o}</Badge>
                  </li>
                ))}
              </ul>
            </div>
          )}
          <div class="mt-auto pt-6">
            <CodeBlock code={cmd.example} language="text" label={commandSection.exampleLabel} wrap />
          </div>
        </Card>
      ))
    }
  </ul>
</Section>
